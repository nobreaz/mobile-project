# Copie este arquivo para server/.env e preencha. O .env NUNCA vai para o Git.
# Onde achar cada valor: supabase/README.md

# Painel do Supabase → botão "Connect" → "Session pooler" (porta 5432).
# Se a senha tiver caracteres especiais (@ : / ? #), codifique-os (ex.: @ → %40).
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Project Settings → API Keys
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
